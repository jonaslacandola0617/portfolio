// prisma/schema.prisma
//
// Phase 0 deliverable — review before running the first migration.
// Design notes are inline as comments; see docs/CMS_MIGRATION_PLAN.md §3 for the full rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (pgbouncer) — used at runtime
  directUrl = env("DIRECT_URL")   // unpooled — used by `prisma migrate`
}

// ─────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/// CMS workflow state — "is this record visible on the public site."
/// Applies uniformly to every content type per the Publishing requirement.
enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SCHEDULED
}

/// Real-world progress state — "how far along is this lab/project/cert."
/// This is the existing `ContentStatus` concept from types/index.ts and
/// StatusBadge.tsx, unchanged in meaning. It is DELIBERATELY a separate
/// field from PublishStatus: a lab can be publishStatus=PUBLISHED while its
/// progressStatus=IN_PROGRESS (you publish the notebook entry *while*
/// still working the lab, same as several of the existing seed labs do).
enum ProgressStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum MediaType {
  IMAGE
  VIDEO
  PACKET_TRACER
  PCAP
  PDF
  ZIP
  OTHER
}

// ─────────────────────────────────────────────────────────
// SHARED TAXONOMY
// ─────────────────────────────────────────────────────────

/// Many-to-many across every content type. `slug` is normalized (lowercase,
/// no punctuation) so /tags/[tag] keeps working with zero page changes.
model Tag {
  id        String          @id @default(cuid())
  name      String          @unique
  slug      String          @unique
  projects  Project[]
  labs      Lab[]
  articles  Article[]
  timeline  TimelineEntry[]
  createdAt DateTime        @default(now())
}

/// One category per content item (not many-to-many) — matches the current
/// free-text `category: string` field on Project/Lab/Article frontmatter,
/// just normalized into a lookup table instead of a duplicated string.
model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  projects Project[]
  labs     Lab[]
  articles Article[]
}

/// NOTE: `group` here is the Skills-page section heading ("Networking",
/// "Cybersecurity", "Programming") — a different axis from Category above
/// (content taxonomy). Kept as a plain string rather than its own table;
/// promote it to a lookup table later if the list of groups grows.
model Skill {
  id           String        @id @default(cuid())
  name         String        @unique
  group        String
  level        String // "learning" | "practiced" | "comfortable"
  projects     Project[]
  certificates Certificate[]
}

model Media {
  id          String    @id @default(cuid())
  url         String // Vercel Blob URL, returned at upload time
  filename    String
  type        MediaType
  size        Int // bytes
  uploadedAt  DateTime  @default(now())
  usedAsThumb Project[] @relation("ProjectThumbnail")
  downloads   Download[]
}

/// Scoped to Project for now (the only content type with a Downloads
/// section today). Nullable FK rather than a polymorphic relation — Prisma
/// doesn't support true polymorphism cleanly; add labId/articleId nullable
/// FKs here if Labs/Articles need downloads later.
model Download {
  id          String   @id @default(cuid())
  label       String
  url         String
  type        String // "packet-tracer" | "config" | "github" | "pdf" | "other"
  description String?
  sortOrder   Int      @default(0)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String?
  lab         Lab?     @relation(fields: [labId], references: [id], onDelete: Cascade)
  labId       String?
  media       Media?   @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  mediaId     String?

  @@index([projectId, sortOrder])
  @@index([labId, sortOrder])
  @@index([mediaId])
}

// ─────────────────────────────────────────────────────────
// CONTENT TYPES
// content: Json  ← TipTap/ProseMirror document, NOT markdown/MDX
// ─────────────────────────────────────────────────────────

model Project {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  summary        String
  content        Json
  difficulty     Difficulty
  progressStatus ProgressStatus @default(PLANNED)
  publishStatus  PublishStatus  @default(DRAFT)
  category       Category?      @relation(fields: [categoryId], references: [id])
  categoryId     String?
  tags           Tag[]
  skills         Skill[]
  technologies   String[]       @default([])
  certificates   Certificate[]
  downloads      Download[]
  thumbnail      Media?         @relation("ProjectThumbnail", fields: [thumbnailId], references: [id])
  thumbnailId    String?
  githubUrl      String?
  estimatedTime  String?
  completionDate DateTime
  publishedAt    DateTime?
  scheduledFor   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([publishStatus, publishedAt])
}

model Lab {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  purpose        String
  content        Json
  difficulty     Difficulty
  progressStatus ProgressStatus @default(PLANNED)
  publishStatus  PublishStatus  @default(DRAFT)
  category       Category?      @relation(fields: [categoryId], references: [id])
  categoryId     String?
  tags           Tag[]
  downloads      Download[]
  labDate        DateTime // the "date" a lab was performed, distinct from createdAt/updatedAt
  publishedAt    DateTime?
  scheduledFor   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([publishStatus, labDate])
}

model Article {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  summary       String
  content       Json
  date          DateTime // authored/dated timeline, distinct from publishedAt (CMS workflow) —
  // same reasoning as Project.completionDate and Lab.labDate
  publishStatus PublishStatus @default(DRAFT)
  category      Category?     @relation(fields: [categoryId], references: [id])
  categoryId    String?
  tags          Tag[]
  publishedAt   DateTime?
  scheduledFor  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([publishStatus, publishedAt])
}

model Certificate {
  id              String         @id @default(cuid())
  slug            String         @unique // stable reference for Project.relatedCertification
  // reconciliation (see prisma/seed/certificates.ts) — the original static
  // data used readable ids like "ccna" for this same purpose; cuid() ids
  // aren't suitable for that, so slug carries it instead.
  name            String
  issuer          String
  logo            String // icon key consumed by CertificateCard ("google" | "cisco" | "linux" | "python")
  content         Json? // optional longer write-up; card view uses the scalar fields below
  progressStatus  ProgressStatus @default(IN_PROGRESS)
  publishStatus   PublishStatus  @default(DRAFT)
  progressLabel   String
  progressPercent Int            @default(0)
  dateStarted     DateTime
  dateCompleted   DateTime?
  credentialUrl   String?
  skills          Skill[]
  projects        Project[]
  publishedAt     DateTime?
  scheduledFor    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model TimelineEntry {
  id            String        @id @default(cuid())
  date          DateTime
  title         String
  description   String
  category      String // "networking" | "security" | "linux" | "programming" | "milestone"
  tags          Tag[]
  publishStatus PublishStatus @default(PUBLISHED) // timeline entries default-publish; they're low-risk
  publishedAt   DateTime?
  scheduledFor  DateTime?
  createdAt     DateTime      @default(now())

  @@index([publishStatus, date])
}

/// Singleton row (id is always "singleton") powering the CMS "Settings"
/// screen — name, bio, links, and the home page's "Currently Learning"
/// list, currently hardcoded in lib/site-config.ts. That file becomes the
/// seed default rather than the runtime source of truth.
model SiteSettings {
  id                String   @id @default("singleton")
  name              String
  role              String
  tagline           String
  email             String
  githubUrl         String
  linkedinUrl       String
  resumeUrl         String
  currentlyLearning Json // [{ label: string, href: string }]
  aboutPage        Json?
  updatedAt         DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────
// FUTURE — revision history (NOT implemented in Phase 0)
// ─────────────────────────────────────────────────────────
//
// Confirmed as a Phase 4+ requirement. Nothing above blocks adding it:
// `content` is already an opaque Json blob, `updatedAt` already exists on
// every content model, and cuid() ids are stable snapshot targets. When
// it's time, the plan is one revision table per content type (same
// non-polymorphic pattern already used for Download, rather than one
// generic table trying to reference four different parents):
//
//   model ProjectRevision {
//     id        String   @id @default(cuid())
//     project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
//     projectId String
//     content   Json               // snapshot of Project.content at save time
//     editedBy  String             // admin email/id at time of save
//     label     String?            // optional "v3" / "before troubleshooting rewrite"
//     createdAt DateTime @default(now())
//     @@index([projectId, createdAt])
//   }
//
// ...mirrored as LabRevision, ArticleRevision, CertificateRevision. Adding
// these later is a pure additive migration — no existing column changes.
