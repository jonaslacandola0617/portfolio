# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/cyber_portfolio?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/cyber_portfolio?sslmode=require"

# Auth.js
# Generate a secret with: npx auth secret
AUTH_SECRET="run-npx-auth-secret-to-generate"

# GitHub OAuth App
# Local homepage: http://localhost:3000
# Local callback: http://localhost:3000/api/auth/callback/github
# Production homepage: https://www.jonasl.online
# Production callback: https://www.jonasl.online/api/auth/callback/github
AUTH_GITHUB_ID="your-github-oauth-app-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-app-client-secret"

# GitHub project sync (optional GitHub App)
# Public repositories are detected without these values. Configure this app
# to let Project Management discover only the private/selected repositories
# you grant it access to, similar to Vercel's GitHub integration.
GITHUB_PROJECT_APP_ID="your-github-app-id"
GITHUB_PROJECT_APP_SLUG="your-github-app-slug"
# Store the PEM private key as a single env value; escaped \n line breaks are supported.
GITHUB_PROJECT_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Only this email is allowed to sign in to /admin.
ADMIN_EMAIL="you@example.com"

# Media (Vercel Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Contact form (Resend)
# Create a Sending access key restricted to the verified mail.jonasl.online domain.
RESEND_API_KEY="re_..."

# Private CMS AI/voice authenticity checker (Gemini)
# Keep this server-only. Do not prefix it with NEXT_PUBLIC_.
# Without this key, the checker still runs its local stylometry/voice comparison.
GEMINI_API_KEY="your-google-ai-studio-api-key"
# Optional override; the current stable default is gemini-3.1-flash-lite.
GEMINI_AI_CHECK_MODEL="gemini-3.1-flash-lite"
