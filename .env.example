# ── Database (Neon Postgres) ──────────────────────────────────────────────
# Neon gives you two connection strings — pooled (for the app at runtime)
# and direct/unpooled (for `prisma migrate`, which doesn't work through a
# pooler). Copy both from the Neon dashboard's "Connection Details" panel.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/cyber_portfolio?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/cyber_portfolio?sslmode=require"

# ── Auth.js (next-auth v5, beta — see docs/PHASE_0_REPORT.md for why) ─────
# Generate with: npx auth secret
AUTH_SECRET="run-npx-auth-secret-to-generate"

# GitHub OAuth App — create at https://github.com/settings/developers
# Homepage URL: http://localhost:3000 (or your deployed URL)
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="your-github-oauth-app-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-app-client-secret"

# Only this email is allowed to sign in to /admin. Must match the primary
# email on the GitHub account you authenticate with.
ADMIN_EMAIL="you@example.com"

# ── Media (Vercel Blob) — not needed until Phase 5, listed here for reference ──
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
