# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/cyber_portfolio?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/cyber_portfolio?sslmode=require"

# Auth.js
# Generate a secret with: npx auth secret
AUTH_SECRET="run-npx-auth-secret-to-generate"

# GitHub OAuth App
# Local homepage: http://localhost:3000
# Local callback: http://localhost:3000/api/auth/callback/github
# Production homepage: https://www.jonasl.online
# Production callback: https://www.jonasl.online/api/auth/callback/github
AUTH_GITHUB_ID="your-github-oauth-app-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-app-client-secret"

# Only this email is allowed to sign in to /admin.
ADMIN_EMAIL="you@example.com"

# Media (Vercel Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
